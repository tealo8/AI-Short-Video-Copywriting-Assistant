# ============================================================
# Docker 部署覆盖配置（可选项）
# 复制为根目录 .env 后 docker compose 自动读取；不创建则全部走默认值
# ============================================================

# 端口（默认值）
WEB_PORT=80                  # 前端访问端口
BACKEND_PORT=8000            # 后端 API 端口（/docs 文档）

# 云端模型降级（可选，填 Key 即启用）
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.deepseek.com
CLOUD_MODEL=deepseek-chat

# Ollama（本机已装则保持默认；容器内自动访问宿主机 11434）
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# 批量参数
BATCH_MAX_WORKERS=2
BATCH_ITEM_LIMIT=50

# 构建加速（国内网络建议）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
