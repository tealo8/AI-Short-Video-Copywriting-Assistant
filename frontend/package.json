{
  "name": "ai-content-studio-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs=require('fs');['dist','node_modules/.vite'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "build": "vite build",
    "build:lowmem": "node --max-old-space-size=512 node_modules/vite/bin/vite.js build",
    "preview": "vite preview"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.11"
  }
}
