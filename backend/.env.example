# ===== AI 内容工场 后端环境配置 =====
# 复制为 .env 后按需修改；所有项均有默认值，本地启动零配置即可跑起来。

# ---------- 应用 ----------
DEBUG=false
LOG_LEVEL=INFO

# ---------- 安全（生产必须修改） ----------
SECRET_KEY=change-me-in-production-8f2c9d1e7a
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 数据库（SQLite 本地 / MySQL 线上切换） ----------
# SQLite:
DATABASE_URL=sqlite:///./data/app.db
# MySQL (生产):
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/aicontent?charset=utf8mb4

# ---------- AI Provider 链（顺序即降级顺序） ----------
LLM_PROVIDER_PRIORITY=ollama,cloud,mock
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_RETRIES=2
LLM_TIMEOUT=180

# ---------- Ollama 本地模型 ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=5m

# ---------- 云端 OpenAI 兼容接口（DeepSeek/通义/OpenAI 通用） ----------
CLOUD_BASE_URL=https://api.deepseek.com
CLOUD_API_KEY=
CLOUD_MODEL=deepseek-chat
CLOUD_TIMEOUT=120

# ---------- 批量任务 ----------
BATCH_MAX_WORKERS=2
BATCH_ITEM_LIMIT=50

# ---------- 质量规则 ----------
TTS_MAX_SENTENCE_LEN=42
MIN_SCRIPT_SEGMENTS=3
